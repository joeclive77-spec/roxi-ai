# AI Assistant API configuration
APP_NAME="AI Assistant"
APP_ENV="development"
# Backend
API_HOST="0.0.0.0"
API_PORT="8000"
CORS_ORIGINS='["*"]'

# LLM Orchestrator
# OpenAI-compatible endpoint (works with OpenAI, local vLLM/Ollama, etc.)
LLM_API_KEY="sk-xxx-placeholder"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_CHAT_MODEL="gpt-4o-mini"
# Comma-separated fallback reasoning/agent models
LLM_AGENT_MODELS="gpt-4o"
LLM_MAX_TOKENS="4096"

# Real-time Web Search grounding (Tavily)
TAVILY_API_KEY="tvly-xxx-placeholder"
SEARCH_ENDPOINT="https://api.tavily.com/search"

# Image generation
IMAGE_MODEL="dall-e-3"
IMAGE_SIZE="1024x1024"

# Voice / TTS
TTS_VOICE="alloy"
STT_MODEL="whisper-1"

# Database (Postgres + pgvector). Empty = in-memory fallback for dev.
DATABASE_URL=""

# Rate limiting
RATE_LIMIT_PER_MIN="60"
RATE_LIMIT_TOKENS_PER_DAY="100000"